# mock | agent | finetuned
VITE_ENGINE=mock

# 배포할 때만. 백엔드 주소를 /api/v1 까지 (예: https://api.example.com/api/v1). 비우면 vite 프록시
VITE_API_BASE=

# 소셜 로그인 client id. 비어 있는 제공자는 mock 이 아닐 때 버튼을 숨긴다.
# 시크릿은 여기 두지 않는다 (백엔드 .env). Redirect URI: {origin}/auth/{kakao|google}/callback
# developers.kakao.com → 앱 키 → REST API 키
VITE_KAKAO_CLIENT_ID=
# console.cloud.google.com → OAuth 클라이언트 ID (웹 애플리케이션)
VITE_GOOGLE_CLIENT_ID=

# 보호자 본인인증(만 14세 이상, 가입할 때 한 번). 포트원 V2 + KG이니시스 본인인증 채널
# admin.portone.io → 결제 연동 → 연동 정보: 상점 아이디(store-…), 채널 관리의 본인인증 채널 키(channel-key-…)
# 둘 다 공개해도 되는 값이다. API Secret 은 여기 두지 않는다 (백엔드 .env PORTONE_API_SECRET). 비우면 실서버 모드에서 묻지 않는다
VITE_PORTONE_STORE_ID=
VITE_PORTONE_IDV_CHANNEL_KEY=
