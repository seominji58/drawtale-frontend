# mock | agent | finetuned
VITE_ENGINE=mock

# 소셜 로그인 client id. 비어 있는 제공자는 mock 이 아닐 때 버튼을 숨긴다.
# 시크릿은 여기 두지 않는다 (백엔드 .env). Redirect URI: {origin}/auth/{kakao|google}/callback
# developers.kakao.com → 앱 키 → REST API 키
VITE_KAKAO_CLIENT_ID=
# console.cloud.google.com → OAuth 클라이언트 ID (웹 애플리케이션)
VITE_GOOGLE_CLIENT_ID=
